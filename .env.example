# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Database (PostgreSQL, via Prisma) ───────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/styleai?schema=public"

# ── Auth.js / NextAuth ───────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional social login — leave blank to disable that provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ── Storage ──────────────────────────────────────────────────────────────
# Leave S3_* blank to use local-disk DEMO MODE storage (.data/uploads, served
# through signed /api/files/* URLs). Set all of these to use S3-compatible
# object storage (AWS S3, Cloudflare R2, Backblaze B2, etc.) in production.
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
# Used to sign local-mode file URLs; falls back to NEXTAUTH_SECRET if unset.
STORAGE_SIGNING_SECRET=

# ── AI Provider ──────────────────────────────────────────────────────────
# "demo" (default, no external calls, deterministic mock results) or
# "production" (requires OPENAI_API_KEY below; falls back to demo if missing).
AI_PROVIDER=demo

# Text generation + image analysis (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Virtual try-on (Replicate — point at a garment-aware try-on model deployment)
REPLICATE_API_TOKEN=
REPLICATE_TRYON_MODEL_VERSION=

# ── Payments (subscription upgrades — wire a real webhook in production) ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
