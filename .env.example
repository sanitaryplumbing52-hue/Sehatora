# Copy this file to .env and adjust before running `docker compose up`.
# This file is consumed by docker-compose.yml and passed into the backend,
# celery-worker and celery-beat containers.

# --- Django ---
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
DJANGO_SETTINGS_MODULE=config.settings.production
CORS_ALLOWED_ORIGINS=http://localhost,https://your-domain.com
CSRF_TRUSTED_ORIGINS=http://localhost,https://your-domain.com
FRONTEND_URL=http://localhost

# --- Database (consumed by the db container too) ---
DB_NAME=sehatora_crm
DB_USER=sehatora
DB_PASSWORD=change-me-strong-password

# --- JWT ---
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# --- Email (SMTP) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=crm@yourdomain.com

# --- Object storage (optional, S3-compatible) ---
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=me-central-1

# --- Misc ---
TIME_ZONE=Asia/Dubai
LOG_LEVEL=INFO

# --- Compose-only knobs ---
# Publish the frontend/nginx container on this host port.
HTTP_PORT=80
# Set to true once (or leave true) to populate demo data on first boot.
SEED_DEMO_DATA=true
